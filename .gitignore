# ============================================
# MyFavor 项目根 .gitignore
# ============================================

# === macOS ===
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes

# === Windows ===
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# === IDE / 编辑器 ===
.vscode/
.idea/
*.swp
*.swo

# === Xcode ===
build/
DerivedData/
*.xcuserstate
*.xcuserdatad/
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
.swiftpm/
.build/
Packages/
Package.pins
Package.resolved

# CocoaPods
Pods/
*.xcworkspace
!default.xcworkspace

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/**/*.png
fastlane/test_output

# === Node.js(后端) ===
node_modules/
dist/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# === 环境变量 / 密钥(关键!)===
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# === 数据库 ===
*.db
*.db-journal
*.sqlite
*.sqlite3
backend/prisma/migrations/dev/

# === Python(辅助脚本)===
__pycache__/
*.pyc
*.pyo
.venv/

# === 临时 / 测试 ===
*.tmp
*.bak
test.txt
test_*.py
debug.py

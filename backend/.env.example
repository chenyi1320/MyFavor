# === 应用元信息(自托管开源项目,完全由你定义)===
# 显示在邮件标题、App 内、登录页等位置
APP_NAME="MyFavor"
APP_URL_SCHEME="myfavor"

# === 数据库 ===
# 开发用本地 SQLite:
DATABASE_URL="file:./dev.db"
# 生产用 SQLPub MySQL(注意,使用前需在 schema.prisma 改 provider = "mysql"):
# DATABASE_URL="mysql://user:pass@host.sqlpub.com:3306/dbname"
# ⚠️ 如果密码含特殊字符(@ # $ %),需 URL-encode(用 https://www.urlencoder.org)
# ⚠️ SQLPub 通常需要 SSL,加 ?ssl-mode=REQUIRED

# === 邮件服务(SMTP 优先,留空 SMTP_HOST 才用 Resend) ===
#
# 模式 A: SMTP(推荐用于自托管,适配任何标准 SMTP 服务商)
#   设置 SMTP_HOST 即启用 Resend 自动失效
#   适用:Gmail / 阿里云 DirectMail / 163 / QQ / Mailpit / 自建 Postfix
#   取消下面 4 行的注释并填写即可切换
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="465"                       # 465=SSL, 587=STARTTLS
# SMTP_USER="you@gmail.com"
# SMTP_PASS="abcdefghijklmnop"          # Gmail 用 16 位 App Password(非登录密码)
# SMTP_FROM="MyFavor <noreply@myfavor.com>"  # 可选,默认用 SMTP_USER
#
# 模式 B: Resend(默认,SMTP_HOST 未设时启用)
#   注册:https://resend.com -> Dashboard -> API Keys -> Create
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# 开发期用 onboarding@resend.dev,上线后改成自己域名 noreply@你的域名
RESEND_FROM_EMAIL="MyFavor <onboarding@resend.dev>"
APP_URL="http://localhost:3000"

# === JWT ===
# 生成:openssl rand -hex 64
JWT_SECRET="change_me_to_a_random_64_byte_hex_string"
JWT_EXPIRES_IN="30d"

# === 服务器 ===
PORT=3000
NODE_ENV=development

